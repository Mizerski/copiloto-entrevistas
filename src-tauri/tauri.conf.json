{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copiloto",
  "version": "0.1.0",
  "identifier": "com.wesley.copiloto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Copiloto",
        "width": 440,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Wesley Mizerski",
    "category": "Productivity",
    "shortDescription": "Copiloto de entrevistas ao vivo",
    "longDescription": "Transcreve entrevistas reais (Teams, Meet, Zoom), acompanha o roteiro e as competências e ajuda a escrever o parecer. Tudo local, com as chaves de API de cada pessoa.",
    "copyright": "© 2026 Wesley Mizerski",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}